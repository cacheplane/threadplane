{
  "name": "website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/website/src",
  "projectType": "application",
  "implicitDependencies": [
    "cockpit-ag-ui-a2ui-react",
    "cockpit-chat-a2ui-react",
    "cockpit-chat-debug-react",
    "cockpit-chat-theming-react",
    "workspace-react",
    "cockpit-langgraph-streaming-angular",
    "cockpit-langgraph-streaming-react",
    "cockpit-ag-ui-streaming-angular",
    "cockpit-ag-ui-interrupts-angular",
    "cockpit-ag-ui-tool-views-angular",
    "cockpit-ag-ui-json-render-angular",
    "cockpit-ag-ui-subagents-angular",
    "cockpit-chat-threads-angular",
    "cockpit-render-computed-functions-angular",
    "cockpit-ag-ui-client-tools-react",
    "cockpit-ag-ui-client-tools-angular",
    "cockpit-runtimes-mastra-react",
    "cockpit-runtimes-microsoft-agent-framework-react",
    "cockpit-runtimes-aws-strands-react"
  ],
  "tags": ["scope:website", "scope:website-e2e", "type:app"],
  "targets": {
    "generate-api-docs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-api-docs.ts",
        "{projectRoot}/scripts/api-reference/**/*",
        "{projectRoot}/scripts/tsconfig.api.json",
        "{projectRoot}/scripts/public-doc-projection.ts",
        "{projectRoot}/src/lib/api-reference-model.ts",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "sdkApiSources"
      ],
      "outputs": ["{projectRoot}/content/api"],
      "options": { "command": "node --import tsx apps/website/scripts/generate-api-docs.ts" }
    },
    "package-content": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["generate-api-docs"],
      "outputs": ["{workspaceRoot}/dist/apps/website/content"],
      "options": { "command": "node apps/website/scripts/package-website-content.mjs" }
    },
    "build": {
      "dependsOn": ["package-content"],
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/website"
      },
      "configurations": {
        "development": {
          "outputPath": "dist/apps/website"
        },
        "production": {
          "outputPath": "dist/apps/website"
        }
      },
      "inputs": [
        "default",
        "sdkApiSources",
        "deploymentConfig",
        "^default",
        { "env": "THREADPLANE_DOCS_BUILD_REVISION" },
        { "runtime": "git rev-parse HEAD" }
      ]
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "website:build",
        "dev": true,
        "port": 3000
      },
      "configurations": {
        "development": {
          "buildTarget": "website:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "website:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "website:build:production"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "apps/website/vite.config.mts"
      }
    },
    "public-copy": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [],
      "options": {
        "config": "apps/website/public-copy.playwright.config.ts",
        "skipInstall": true
      }
    },
    "e2e-control-plane": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "cockpit-langgraph-streaming-react",
            "cockpit-langgraph-persistence-react",
            "cockpit-langgraph-durable-execution-react",
            "cockpit-langgraph-client-tools-react",
            "cockpit-langgraph-deployment-runtime-react",
            "cockpit-ag-ui-streaming-react",
            "cockpit-deep-agents-filesystem-react",
            "cockpit-render-state-management-react"
          ]
        }
      ],
      "options": {
        "config": "apps/website/e2e-control-plane.playwright.config.ts",
        "skipInstall": true
      }
    },
    "e2e-agents": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "cockpit-langgraph-streaming-react",
            "cockpit-langgraph-interrupts-react",
            "cockpit-langgraph-memory-react",
            "cockpit-langgraph-client-tools-react",
            "cockpit-langgraph-persistence-react",
            "cockpit-langgraph-durable-execution-react",
            "cockpit-langgraph-subgraphs-react",
            "cockpit-langgraph-time-travel-react",
            "cockpit-langgraph-deployment-runtime-react",
            "cockpit-deep-agents-planning-react",
            "cockpit-deep-agents-filesystem-react",
            "cockpit-deep-agents-subagents-react",
            "cockpit-deep-agents-skills-react",
            "cockpit-deep-agents-memory-react"
          ]
        }
      ],
      "options": {
        "config": "apps/website/e2e-agents.playwright.config.ts",
        "skipInstall": true
      }
    },
    "e2e-ag-ui": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        {
          "target": "prepare-fixture",
          "projects": [
            "cockpit-ag-ui-a2ui-react"
          ]
        },
        {
          "target": "build",
          "projects": [
            "cockpit-ag-ui-a2ui-react",
            "cockpit-ag-ui-streaming-react",
            "cockpit-ag-ui-interrupts-react",
            "cockpit-ag-ui-tool-views-react",
            "cockpit-ag-ui-json-render-react",
            "cockpit-ag-ui-subagents-react",
            "cockpit-ag-ui-client-tools-react"
          ]
        }
      ],
      "options": {
        "config": "apps/website/e2e-ag-ui.playwright.config.ts",
        "skipInstall": true
      }
    },
    "e2e-chat": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        {
          "target": "fixture-test",
          "projects": [
            "cockpit-chat-a2ui-react"
          ]
        },
        {
          "target": "test",
          "projects": [
            "cockpit-chat-theming-python",
            "cockpit-chat-debug-python"
          ]
        },
        {
          "target": "build",
          "projects": [
            "cockpit-chat-a2ui-react",
            "cockpit-chat-messages-react",
            "cockpit-chat-theming-react",
            "cockpit-chat-debug-react",
            "cockpit-chat-input-react",
            "cockpit-chat-interrupts-react",
            "cockpit-chat-tool-calls-react",
            "cockpit-chat-subagents-react",
            "cockpit-chat-threads-react",
            "cockpit-chat-timeline-react",
            "cockpit-chat-generative-ui-react"
          ]
        }
      ],
      "options": {
        "config": "apps/website/e2e-chat.playwright.config.ts",
        "skipInstall": true
      }
    },
    "e2e-render": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        {
          "target": "prepare-fixture",
          "projects": [
            "cockpit-runtimes-mastra-react",
            "cockpit-runtimes-microsoft-agent-framework-react",
            "cockpit-runtimes-aws-strands-react"
          ]
        },
        {
          "target": "build",
          "projects": [
            "cockpit-render-spec-rendering-react",
            "cockpit-render-state-management-react",
            "cockpit-render-repeat-loops-react",
            "cockpit-render-registry-react",
            "cockpit-render-element-rendering-react",
            "cockpit-render-computed-functions-react",
            "cockpit-runtimes-mastra-react",
            "cockpit-runtimes-microsoft-agent-framework-react",
            "cockpit-runtimes-aws-strands-react"
          ]
        }
      ],
      "options": {
        "config": "apps/website/e2e-render.playwright.config.ts",
        "skipInstall": true
      }
    },
    "deployed-e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [],
      "options": {
        "config": "apps/website/deployed.playwright.config.ts",
        "skipInstall": true
      }
    },
    "docs-audit": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "commands": [
          "tsc --project apps/website/tsconfig.docs-audit.json",
          "node --import tsx --test apps/website/scripts/docs-protected-request.browser-test.ts",
          "tsx apps/website/scripts/run-docs-audit.ts"
        ],
        "parallel": false
      }
    },
    "verify-docs-deployment": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "tsx apps/website/scripts/verify-docs-deployment.ts"
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "dependsOn": [
        {
          "target": "fixture-test",
          "projects": ["cockpit-chat-a2ui-react"]
        },
        {
          "target": "test",
          "projects": ["cockpit-chat-theming-python", "cockpit-chat-debug-python"]
        },
        {
          "target": "prepare-fixture",
          "projects": ["cockpit-runtimes-mastra-react", "cockpit-runtimes-microsoft-agent-framework-react", "cockpit-runtimes-aws-strands-react", "cockpit-ag-ui-a2ui-react"]
        },
        {
          "target": "build",
          "projects": [
            "cockpit-chat-a2ui-react",
            "cockpit-ag-ui-a2ui-react",
            "cockpit-langgraph-streaming-react",
            "cockpit-langgraph-interrupts-react",
            "cockpit-langgraph-memory-react",
            "cockpit-langgraph-client-tools-react",
            "cockpit-langgraph-persistence-react",
            "cockpit-langgraph-durable-execution-react",
            "cockpit-langgraph-subgraphs-react",
            "cockpit-langgraph-time-travel-react",
            "cockpit-langgraph-deployment-runtime-react",
            "cockpit-ag-ui-streaming-react",
            "cockpit-ag-ui-interrupts-react",
            "cockpit-ag-ui-tool-views-react",
            "cockpit-ag-ui-json-render-react",
            "cockpit-ag-ui-subagents-react",
            "cockpit-render-spec-rendering-react",
            "cockpit-render-state-management-react",
            "cockpit-render-repeat-loops-react",
            "cockpit-render-registry-react",
            "cockpit-render-element-rendering-react",
            "cockpit-render-computed-functions-react",
            "cockpit-chat-messages-react",
            "cockpit-chat-theming-react",
            "cockpit-chat-debug-react",
            "cockpit-chat-input-react",
            "cockpit-chat-interrupts-react",
            "cockpit-chat-tool-calls-react",
            "cockpit-chat-subagents-react",
            "cockpit-chat-threads-react",
            "cockpit-chat-timeline-react",
            "cockpit-chat-generative-ui-react",
            "cockpit-deep-agents-planning-react",
            "cockpit-deep-agents-filesystem-react",
            "cockpit-deep-agents-subagents-react",
            "cockpit-deep-agents-skills-react",
            "cockpit-deep-agents-memory-react",
            "cockpit-ag-ui-client-tools-react",
            "cockpit-runtimes-mastra-react",
            "cockpit-runtimes-microsoft-agent-framework-react",
            "cockpit-runtimes-aws-strands-react"
          ]
        }
      ],
      "options": {
        "config": "apps/website/playwright.config.ts"
      }
    }
  },
  "namedInputs": {
    "sdkApiSources": [
      "{workspaceRoot}/libs/*/project.json",
      "{workspaceRoot}/libs/a2ui/**/*",
      "{workspaceRoot}/libs/ag-ui/**/*",
      "{workspaceRoot}/libs/angular/**/*",
      "{workspaceRoot}/libs/chat/**/*",
      "{workspaceRoot}/libs/content/**/*",
      "{workspaceRoot}/libs/core/**/*",
      "{workspaceRoot}/libs/langgraph/**/*",
      "{workspaceRoot}/libs/middleware/**/*",
      "{workspaceRoot}/libs/react/**/*",
      "{workspaceRoot}/libs/render/**/*",
      "{workspaceRoot}/libs/telemetry/**/*"
    ],
    "deploymentConfig": ["{workspaceRoot}/vercel.json"]
  }
}
