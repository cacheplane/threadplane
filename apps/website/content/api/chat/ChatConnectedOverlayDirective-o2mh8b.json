      "angular": {
        "selector": "[chatConnectedOverlay]",
        "inputs": [
          {
            "name": "open",
            "alias": "chatOverlayOpen",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "origin",
            "alias": "chatOverlayOrigin",
            "required": true,
            "type": "ChatOverlayOriginDirective"
          },
          {
            "name": "panelClass",
            "alias": "chatOverlayPanelClass",
            "required": false,
            "type": "string | string[]"
          },
          {
            "name": "positions",
            "alias": "chatOverlayPositions",
            "required": false,
            "type": "ConnectedPosition[]"
          }
        ],
        "outputs": [
          {
            "name": "attached",
            "alias": "chatOverlayAttached",
            "required": false,
            "type": "HTMLElement"
          },
          {
            "name": "detached",
            "alias": "chatOverlayDetach",
            "required": false,
            "type": "void"
          },
          {
            "name": "outsideClick",
            "alias": "chatOverlayOutsideClick",
            "required": false,
            "type": "MouseEvent"
          }
        ]
      }
    }
  ],
