# marketing/.env.example
#
# Placeholder env var names for the marketing pipeline. Real values live in
# .env at the repo root (gitignored). Copy lines you need into .env and fill
# in your credentials.
#
# Sub-specs may add more keys. This file is documentation, not consumed at
# runtime — each adapter reads its own keys via process.env.

# X / Twitter (OAuth 2.0 with PKCE — see marketing/channels/README.md)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_USER_HANDLE=

# LinkedIn (3-legged OAuth, 60-day token — see marketing/channels/README.md)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_EXPIRES_AT=

# Weekly content automation (Neon holds the channel tokens, sealed; see docs/growth/marketing-queue-rollout.md)
# Base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MARKETING_CREDENTIALS_KEY=
# Neon connection string for the preview marketing database (auth CLIs --target=preview)
MARKETING_DATABASE_URL_PREVIEW=
# Neon connection string for the production marketing database (auth CLIs --target=production)
MARKETING_DATABASE_URL_PRODUCTION=
# Vercel Blob read-write token (queue CLI media upload)
BLOB_READ_WRITE_TOKEN=
# Lifecycle (Vercel) only: dispatcher switch, exact string true enables posting
MARKETING_POSTING_ENABLED=
# Lifecycle (Vercel) only: website deploy hook that publishes a due blog post
MARKETING_WEBSITE_DEPLOY_HOOK_URL=
# Lifecycle (Vercel) only: From address for marketing failure alerts
MARKETING_ALERT_FROM=
# Lifecycle (Vercel) only: where marketing failure alerts are sent (also needs RESEND_API_KEY)
FOUNDER_NOTIFICATION_EMAIL=

# Dev.to
DEVTO_API_KEY=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Pipeline behavior
# DRY_RUN=1   # Adapters return synthetic PostResults; nothing is posted. Preview only on lifecycle, never production.
# MARKETING_DRY_RUN_DIR=tmp/marketing/dry-runs  # Relative to cwd, or an absolute path. Preview lifecycle on Vercel: /tmp/marketing-dry-runs (cwd is read-only).
