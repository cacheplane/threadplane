# Model client configuration — Azure OpenAI is the DEFAULT path.
#
# When AZURE_OPENAI_ENDPOINT is set, the agent routes through Azure OpenAI
# (key auth). When it is absent, the agent falls back to the plain OpenAI
# client on OPENAI_API_KEY. Placeholder values only — never commit real
# endpoints or keys.

# --- Azure OpenAI (default when set) ---
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# Deployment name of a chat model in your Azure resource.
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- OpenAI fallback (used only when AZURE_OPENAI_ENDPOINT is unset) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
