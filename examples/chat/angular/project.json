{
  "name": "examples-chat-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/chat/angular/src",
  "projectType": "application",
  "prefix": "app",
  "targets": {
    "inject-env": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node examples/chat/angular/scripts/inject-env.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["inject-env"],
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/examples/chat/angular",
          "browser": ""
        },
        "index": "examples/chat/angular/src/index.html",
        "browser": "examples/chat/angular/src/main.ts",
        "tsConfig": "examples/chat/angular/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "examples/chat/angular/public"
          }
        ],
        "styles": [
          "node_modules/katex/dist/katex.min.css",
          "examples/chat/angular/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "define": {
            "THREADPLANE_CHAT_DEBUG": "false"
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.6mb",
              "maximumError": "1.85mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "examples/chat/angular/src/environments/generated-keys.ts",
              "with": "examples/chat/angular/src/environments/generated-keys.local.ts"
            }
          ]
        },
        "production-debug": {
          "define": {
            "THREADPLANE_CHAT_DEBUG": "true"
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.6mb",
              "maximumError": "1.85mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "define": {
            "THREADPLANE_CHAT_DEBUG": "false"
          },
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "examples/chat/angular/src/environments/environment.ts",
              "with": "examples/chat/angular/src/environments/environment.development.ts"
            },
            {
              "replace": "examples/chat/angular/src/environments/generated-keys.ts",
              "with": "examples/chat/angular/src/environments/generated-keys.local.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["inject-env"],
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "examples-chat-angular:build:production"
        },
        "development": {
          "buildTarget": "examples-chat-angular:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "examples/chat/angular/vite.config.mts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "options": {
        "config": "examples/chat/angular/e2e/playwright.config.ts"
      }
    },
    "drift": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/chat/angular",
        "command": "tsx ../../../libs/e2e-harness/src/drift.ts e2e/.aimock-recordings e2e/fixtures"
      }
    }
  },
  "tags": [
    "scope:angular-compatibility",
    "scope:examples",
    "scope:examples-chat",
    "type:app"
  ]
}
