{
  "name": "native-conversation-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "examples/chat/native/react/src",
  "tags": ["scope:example", "type:app", "framework:react"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "outputs": ["{workspaceRoot}/dist/examples/chat/native/react"],
      "defaultConfiguration": "production",
      "configurations": {
        "production": {},
        "development": {}
      },
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node examples/chat/native/tooling/run.mjs build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": [],
      "defaultConfiguration": "development",
      "configurations": {
        "development": {}
      },
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node examples/chat/native/tooling/run.mjs serve"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node examples/chat/native/tooling/run.mjs test"
      }
    },
    "tooling-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node --test examples/chat/native/tooling/*.spec.mjs"
      }
    },
    "copy-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node node_modules/vitest/vitest.mjs run --config examples/chat/native/react/vitest.config.mts"
      }
    },
    "provider-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node node_modules/typescript/bin/tsc -p examples/chat/native/tooling/tsconfig.approval-provider-host.json",
          "node --import tsx --test examples/chat/native/tooling/approval-provider.spec.ts",
          "node node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.base.json examples/chat/native/tooling/approval-provider.ts",
          "node node_modules/typescript/bin/tsc -p examples/chat/native/tooling/tsconfig.backup-provider-host.json",
          "node --import tsx --test examples/chat/native/tooling/backup-provider.spec.ts",
          "node node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.base.json examples/chat/native/tooling/backup-provider.ts"
        ]
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [],
      "options": {
        "config": "examples/chat/native/e2e/playwright.config.ts",
        "skipInstall": true
      }
    },
    "summary-provider-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node node_modules/typescript/bin/tsc -p examples/chat/native/tooling/tsconfig.trip-summary-provider-host.json",
          "node --import tsx --test examples/chat/native/tooling/trip-summary-provider.spec.ts",
          "node node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.base.json examples/chat/native/tooling/trip-summary-provider.ts"
        ]
      }
    }
  }
}
