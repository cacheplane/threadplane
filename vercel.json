{
  "buildCommand": "npx nx build website",
  "outputDirectory": "dist/apps/website/.next",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/inbox-recovery",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "*/30 * * * *"
    }
  ]
}
