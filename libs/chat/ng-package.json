{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/chat",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "allowedNonPeerDependencies": [
    "@cacheplane/partial-json",
    "@cacheplane/partial-markdown"
  ],
  "assets": [
    {
      "input": ".install-collector",
      "glob": "development-install.*",
      "output": ".install-collector"
    },
    {
      "input": "src",
      "glob": "chat.css",
      "output": "."
    },
    {
      "input": "src/themes",
      "glob": "*.css",
      "output": "themes"
    },
    {
      "input": ".",
      "glob": "LICENSE.md",
      "output": "."
    },
    {
      "input": ".",
      "glob": "NOTICE.md",
      "output": "."
    },
    {
      "input": ".",
      "glob": "CHANGELOG.md",
      "output": "."
    },
    {
      "input": ".install-collector",
      "glob": "*.cjs",
      "output": "install"
    }
  ],
  "keepLifecycleScripts": true
}
