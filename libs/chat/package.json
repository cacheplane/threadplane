{
  "name": "@threadplane/chat",
  "version": "0.1.0",
  "description": "The Angular AI agent chat UI: <chat>, headless primitives, interrupts, subagents, and generative UI on Signals.",
  "exports": {
    "./chat.css": "./chat.css",
    "./themes/default-dark.css": "./themes/default-dark.css",
    "./themes/default-light.css": "./themes/default-light.css",
    "./themes/material-dark.css": "./themes/material-dark.css",
    "./themes/material-light.css": "./themes/material-light.css",
    "./development-install": {
      "types": "./.install-collector/development-install.d.ts",
      "default": "./.install-collector/development-install.mjs"
    }
  },
  "dependencies": {
    "@cacheplane/partial-json": ">=0.1.1 <0.3.0",
    "@cacheplane/partial-markdown": "0.5.8"
  },
  "peerDependencies": {
    "@threadplane/telemetry": "^0.1.0",
    "zod": "^3.25.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/router": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@threadplane/render": "0.1.0",
    "@threadplane/a2ui": "0.1.0",
    "@json-render/core": "^0.16.0",
    "rxjs": "~7.8.0",
    "marked": "^15.0.0 || ^16.0.0",
    "katex": "^0.16.0 || ^0.17.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cacheplane/threadplane.git",
    "directory": "libs/chat"
  },
  "homepage": "https://github.com/cacheplane/threadplane#readme",
  "bugs": {
    "url": "https://github.com/cacheplane/threadplane/issues"
  },
  "sideEffects": [
    "**/chat-tokens.ts",
    "./fesm2022/threadplane-chat.mjs",
    "**/*.css"
  ],
  "imports": {
    "#development-install": {
      "types": "./.install-collector/development-install.d.ts",
      "default": "@threadplane/chat/development-install"
    }
  },
  "scripts": {
    "postinstall": "node install/postinstall.cjs"
  }
}
