{
  "name": "@threadplane/content",
  "version": "0.3.7",
  "description": "Framework-neutral content preparation for Threadplane: incremental Markdown and JSON documents and A2UI surface accumulation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cacheplane/threadplane.git",
    "directory": "libs/content"
  },
  "homepage": "https://github.com/cacheplane/threadplane#readme",
  "bugs": {
    "url": "https://github.com/cacheplane/threadplane/issues"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@cacheplane/json-stream": "0.1.1",
    "@cacheplane/partial-markdown": "0.6.1"
  },
  "peerDependencies": {
    "@threadplane/a2ui": "^0.3.7",
    "@threadplane/core": "0.3.7"
  },
  "peerDependenciesMeta": {
    "@threadplane/a2ui": { "optional": true }
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./markdown": {
      "types": "./src/markdown/index.d.ts",
      "import": "./src/markdown/index.js",
      "default": "./src/markdown/index.js"
    },
    "./messages": {
      "types": "./src/messages/index.d.ts",
      "import": "./src/messages/index.js",
      "default": "./src/messages/index.js"
    },
    "./json": {
      "types": "./src/json/index.d.ts",
      "import": "./src/json/index.js",
      "default": "./src/json/index.js"
    },
    "./a2ui": {
      "types": "./src/a2ui/index.d.ts",
      "import": "./src/a2ui/index.js",
      "default": "./src/a2ui/index.js"
    },
    "./render-state": {
      "types": "./src/render-state/index.d.ts",
      "import": "./src/render-state/index.js",
      "default": "./src/render-state/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.d.ts",
      "import": "./src/testing/index.js",
      "default": "./src/testing/index.js"
    }
  }
}
