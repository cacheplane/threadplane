{
  "name": "angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/angular/src",
  "projectType": "library",
  "tags": [
    "scope:react-parity",
    "scope:library",
    "type:lib",
    "layer:angular",
    "scope:angular-compatibility",
    "scope:cockpit",
    "scope:cockpit-e2e",
    "scope:cockpit-examples",
    "scope:cockpit-smoke",
    "scope:examples-chat",
    "scope:website",
    "scope:website-e2e"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/angular/ng-package.json",
        "tsConfig": "libs/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production",
      "inputs": [
        "production",
        "^production",
        "!{projectRoot}/.install-collector/**",
        "{workspaceRoot}/libs/telemetry/install/*",
        "!{projectRoot}/chat/src/lib/package-version.ts",
        "!{projectRoot}/render/src/lib/package-version.ts"
      ],
      "dependsOn": [
        "^build",
        "prepare-install"
      ]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/angular/vite.config.mts"
      },
      "dependsOn": [
        "prepare-install",
        "nonstrict-types"
      ]
    },
    "test-devtools-bundle": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/angular/scripts/verify-devtools-bundle.mjs"
      }
    },
    "type-tests": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "node node_modules/typescript/bin/tsc --project libs/angular/tsconfig.type-tests.json --noEmit --emitDeclarationOnly false --composite false --incremental false && node ./node_modules/typescript/bin/tsc --project libs/angular/tsconfig.chat-type-tests.json --noEmit"
      },
      "dependsOn": [
        "nonstrict-types"
      ]
    },
    "nonstrict-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./node_modules/typescript/bin/tsc --project libs/angular/tsconfig.nonstrict.json"
      },
      "dependsOn": [
        "prepare-install"
      ]
    },
    "prepare-install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/libs/telemetry/install/*.cjs",
        "{workspaceRoot}/libs/telemetry/install/assemble-package.mjs",
        "{projectRoot}/package.json"
      ],
      "outputs": [
        "{projectRoot}/.install-collector",
        "{projectRoot}/chat/src/lib/package-version.ts",
        "{projectRoot}/render/src/lib/package-version.ts"
      ],
      "options": {
        "command": "node libs/telemetry/install/assemble-package.mjs angular",
        "forwardAllArgs": false
      }
    }
  },
  "implicitDependencies": [
    "telemetry"
  ]
}
