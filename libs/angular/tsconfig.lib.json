{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/angular",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "chat/src/**/*.ts",
    "a2ui/**/*.ts",
    "chat/debug/**/*.ts",
    "chat/math/**/*.ts",
    "chat/shared/**/*.ts",
    "chat/citations/**/*.ts",
    "chat/threads/**/*.ts",
    "chat/overlay/**/*.ts",
    "chat/select/**/*.ts",
    "chat/testing/**/*.ts",
    "markdown/src/**/*.ts",
    "render/src/**/*.ts",
    "render/registry/**/*.ts",
    "render/deferred/**/*.ts",
    "testing/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.type-test.ts",
    "src/**/*.type-spec.ts",
    "chat/src/**/*.spec.ts",
    "chat/src/**/*.test.ts",
    "chat/src/**/*.type-test.ts",
    "chat/src/**/*.type-spec.ts",
    "chat/debug/**/*.spec.ts",
    "chat/debug/**/*.test.ts",
    "chat/debug/**/*.type-test.ts",
    "chat/debug/**/*.type-spec.ts",
    "a2ui/**/*.spec.ts",
    "a2ui/**/*.test.ts",
    "a2ui/**/*.type-test.ts",
    "a2ui/**/*.type-spec.ts",
    "chat/math/**/*.spec.ts",
    "chat/math/**/*.test.ts",
    "chat/math/**/*.type-test.ts",
    "chat/math/**/*.type-spec.ts",
    "chat/shared/**/*.spec.ts",
    "chat/shared/**/*.test.ts",
    "chat/shared/**/*.type-test.ts",
    "chat/shared/**/*.type-spec.ts",
    "chat/citations/**/*.spec.ts",
    "chat/citations/**/*.test.ts",
    "chat/citations/**/*.type-test.ts",
    "chat/citations/**/*.type-spec.ts",
    "chat/threads/**/*.spec.ts",
    "chat/threads/**/*.test.ts",
    "chat/threads/**/*.type-test.ts",
    "chat/threads/**/*.type-spec.ts",
    "chat/overlay/**/*.spec.ts",
    "chat/overlay/**/*.test.ts",
    "chat/overlay/**/*.type-test.ts",
    "chat/overlay/**/*.type-spec.ts",
    "chat/select/**/*.spec.ts",
    "chat/select/**/*.test.ts",
    "chat/select/**/*.type-test.ts",
    "chat/select/**/*.type-spec.ts",
    "chat/testing/**/*.spec.ts",
    "chat/testing/**/*.test.ts",
    "chat/testing/**/*.type-test.ts",
    "chat/testing/**/*.type-spec.ts",
    "markdown/src/**/*.spec.ts",
    "markdown/src/**/*.test.ts",
    "markdown/src/**/*.type-test.ts",
    "markdown/src/**/*.type-spec.ts",
    "render/src/**/*.spec.ts",
    "render/src/**/*.test.ts",
    "render/src/**/*.type-test.ts",
    "render/src/**/*.type-spec.ts",
    "render/registry/**/*.spec.ts",
    "render/registry/**/*.test.ts",
    "render/registry/**/*.type-test.ts",
    "render/registry/**/*.type-spec.ts",
    "testing/src/**/*.spec.ts",
    "testing/src/**/*.test.ts",
    "testing/src/**/*.type-test.ts",
    "testing/src/**/*.type-spec.ts",
    "src/test-setup.ts",
    "chat/src/test-setup.ts",
    "render/src/test-setup.ts",
    "chat/src/testing/**/*.ts"
  ],
  "references": [
    {
      "path": "../a2ui/tsconfig.lib.json"
    }
  ]
}
