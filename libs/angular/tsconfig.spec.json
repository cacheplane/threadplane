{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "rootDir": "../..",
    "declaration": false,
    "declarationMap": false,
    "inlineSources": false,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "chat/src/**/*.ts",
    "a2ui/**/*.ts",
    "chat/debug/**/*.ts",
    "render/registry/**/*.ts",
    "render/deferred/**/*.ts",
    "chat/math/**/*.ts",
    "chat/shared/**/*.ts",
    "chat/citations/**/*.ts",
    "chat/threads/**/*.ts",
    "chat/overlay/**/*.ts",
    "chat/select/**/*.ts",
    "chat/testing/**/*.ts",
    "markdown/src/**/*.ts",
    "render/src/**/*.ts",
    "testing/src/**/*.ts"
  ],
  "exclude": []
}
