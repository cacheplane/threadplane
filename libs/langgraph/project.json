{
  "name": "langgraph",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/langgraph/src",
  "projectType": "library",
  "tags": [
    "scope:angular-compatibility",
    "scope:cockpit",
    "scope:cockpit-e2e",
    "scope:cockpit-examples",
    "scope:cockpit-smoke",
    "scope:examples-chat",
    "scope:library",
    "scope:website",
    "scope:website-e2e",
    "layer:backend"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/libs/langgraph"],
      "options": {
        "outputPath": "dist/libs/langgraph",
        "main": "libs/langgraph/src/public-api.ts",
        "tsConfig": "libs/langgraph/tsconfig.lib.json",
        "generatePackageJson": false,
        "assets": [
          "libs/langgraph/package.json",
          "libs/langgraph/LICENSE.md",
          "libs/langgraph/README.md",
          {
            "input": "libs/langgraph/.install-collector",
            "glob": "development-install.*",
            "output": ".install-collector"
          },
          {
            "input": "libs/langgraph/.install-collector",
            "glob": "*.cjs",
            "output": "install",
            "includeIgnoredFiles": true
          }
        ]
      },
      "inputs": [
        "production",
        "^production",
        "!{projectRoot}/.install-collector/**",
        "{workspaceRoot}/libs/telemetry/install/*"
      ],
      "dependsOn": ["^build", "prepare-install"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/langgraph/vite.runtime.config.mts"
      }
    },
    "type-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./node_modules/typescript/bin/tsc --project libs/langgraph/tsconfig.runtime-tests.json"
      }
    },
    "runtime-quality": {
      "executor": "nx:noop",
      "dependsOn": ["test"]
    },
    "runtime-type-tests": {
      "executor": "nx:noop",
      "dependsOn": ["type-tests"]
    },
    "runtime-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node ./node_modules/typescript/bin/tsc --project libs/langgraph/tsconfig.live.json",
          "node ./node_modules/vitest/vitest.mjs run --config libs/langgraph/vite.live.config.mts"
        ],
        "parallel": false
      }
    },
    "prepare-install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/libs/telemetry/install/*.cjs",
        "{workspaceRoot}/libs/telemetry/install/assemble-package.mjs",
        "{projectRoot}/package.json"
      ],
      "outputs": ["{projectRoot}/.install-collector"],
      "options": {
        "command": "node libs/telemetry/install/assemble-package.mjs langgraph",
        "forwardAllArgs": false
      }
    }
  },
  "implicitDependencies": ["telemetry"]
}
