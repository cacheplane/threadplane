{
  "name": "@threadplane/langgraph",
  "version": "0.3.7",
  "description": "Framework-neutral LangGraph agent sessions: createSession() runs a LangGraph deployment behind the Threadplane AgentSession contract.",
  "keywords": [
    "langgraph",
    "langchain",
    "agent",
    "session",
    "threadplane"
  ],
  "type": "module",
  "peerDependencies": {
    "@threadplane/core": "0.3.7",
    "@langchain/core": "^1.1.33",
    "@langchain/langgraph-sdk": "^1.7.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cacheplane/threadplane.git",
    "directory": "libs/langgraph"
  },
  "homepage": "https://github.com/cacheplane/threadplane#readme",
  "bugs": {
    "url": "https://github.com/cacheplane/threadplane/issues"
  },
  "sideEffects": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    ".install-collector/development-install.mjs",
    ".install-collector/development-install.d.ts",
    ".install-collector/development-install.d.mts",
    "install/*.cjs",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/public-api.d.ts",
      "import": "./src/public-api.js",
      "default": "./src/public-api.js"
    },
    "./development-install": {
      "types": "./.install-collector/development-install.d.ts",
      "default": "./.install-collector/development-install.mjs"
    }
  },
  "scripts": {
    "postinstall": "node install/postinstall.cjs"
  }
}
