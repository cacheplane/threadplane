{
  "name": "@threadplane/core",
  "version": "0.3.7",
  "description": "Dependency-free agent contracts for Threadplane: the AgentSession interface, plain snapshots, authored function-tool types and testing fakes.",
  "keywords": [
    "agent",
    "session",
    "contract",
    "threadplane"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cacheplane/threadplane.git",
    "directory": "libs/core"
  },
  "homepage": "https://github.com/cacheplane/threadplane#readme",
  "bugs": {
    "url": "https://github.com/cacheplane/threadplane/issues"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./tools": {
      "types": "./src/tools/index.d.ts",
      "import": "./src/tools/index.js",
      "default": "./src/tools/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.d.ts",
      "import": "./src/testing/index.js",
      "default": "./src/testing/index.js"
    }
  }
}
