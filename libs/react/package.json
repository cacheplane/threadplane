{
  "name": "@threadplane/react",
  "version": "0.0.0",
  "private": true,
  "description": "Private React binding for observing app-owned agent sessions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "peerDependencies": {
    "@threadplane/core": "0.0.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react-dom": "19.2.4"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    "./chat": {
      "types": "./src/chat/index.d.ts",
      "import": "./src/chat/index.js",
      "default": "./src/chat/index.js"
    },
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  }
}
