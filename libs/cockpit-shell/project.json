{
  "name": "cockpit-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cockpit-shell/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/libs/cockpit-shell"],
      "options": {
        "outputPath": "dist/libs/cockpit-shell",
        "main": "libs/cockpit-shell/src/index.ts",
        "tsConfig": "libs/cockpit-shell/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "inputs": ["default", "^default", "contentAssets"],
      "options": {
        "configFile": "libs/cockpit-shell/vite.config.mts"
      }
    }
  },
  "namedInputs": {
    "contentAssets": [
      "{workspaceRoot}/cockpit/**/prompts/**",
      "{workspaceRoot}/cockpit/**/angular/src/**",
      "{workspaceRoot}/cockpit/**/react/src/**",
      "{workspaceRoot}/cockpit/**/python/src/**",
      "{workspaceRoot}/cockpit/**/docs/**",
      "{workspaceRoot}/deployments/ag-ui-mastra/*.mjs"
    ]
  },
  "tags": [
    "scope:cockpit",
    "scope:cockpit-e2e",
    "scope:cockpit-examples"
  ]
}
