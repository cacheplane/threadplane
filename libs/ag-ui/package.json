{
  "name": "@threadplane/ag-ui",
  "version": "0.3.7",
  "description": "Framework-neutral AG-UI agent sessions: createSession() runs any AG-UI-compatible backend behind the Threadplane AgentSession contract.",
  "keywords": [
    "ag-ui",
    "agent",
    "session",
    "threadplane"
  ],
  "type": "module",
  "peerDependencies": {
    "@threadplane/core": "0.3.7",
    "@ag-ui/client": "^1.0.1",
    "rxjs": "~7.8.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cacheplane/threadplane.git",
    "directory": "libs/ag-ui"
  },
  "homepage": "https://github.com/cacheplane/threadplane#readme",
  "bugs": {
    "url": "https://github.com/cacheplane/threadplane/issues"
  },
  "sideEffects": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    ".install-collector/development-install.mjs",
    ".install-collector/development-install.d.ts",
    "install/*.cjs",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/public-api.d.ts",
      "import": "./src/public-api.js",
      "default": "./src/public-api.js"
    },
    "./development-install": {
      "types": "./.install-collector/development-install.d.ts",
      "default": "./.install-collector/development-install.mjs"
    }
  },
  "scripts": {
    "postinstall": "node install/postinstall.cjs"
  }
}
