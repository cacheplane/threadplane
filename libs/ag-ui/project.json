{
  "name": "ag-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ag-ui/src",
  "projectType": "library",
  "tags": [
    "scope:angular-compatibility",
    "scope:cockpit",
    "scope:cockpit-e2e",
    "scope:cockpit-examples",
    "scope:cockpit-smoke",
    "scope:examples-chat",
    "scope:library",
    "scope:website",
    "scope:website-e2e",
    "layer:backend"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/libs/ag-ui"],
      "options": {
        "outputPath": "dist/libs/ag-ui",
        "main": "libs/ag-ui/src/public-api.ts",
        "tsConfig": "libs/ag-ui/tsconfig.lib.json",
        "generatePackageJson": false,
        "assets": [
          "libs/ag-ui/package.json",
          "libs/ag-ui/LICENSE.md",
          "libs/ag-ui/README.md",
          {
            "input": "libs/ag-ui/.install-collector",
            "glob": "development-install.*",
            "output": ".install-collector"
          },
          {
            "input": "libs/ag-ui/.install-collector",
            "glob": "*.cjs",
            "output": "install",
            "includeIgnoredFiles": true
          }
        ]
      },
      "inputs": [
        "production",
        "^production",
        "!{projectRoot}/.install-collector/**",
        "{workspaceRoot}/libs/telemetry/install/*"
      ],
      "dependsOn": ["^build", "prepare-install"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/ag-ui/vite.runtime.config.mts"
      }
    },
    "type-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./node_modules/typescript/bin/tsc --project libs/ag-ui/tsconfig.runtime-tests.json && node ./node_modules/typescript/bin/tsc --project libs/ag-ui/tsconfig.runtime-conformance.json"
      }
    },
    "runtime-quality": {
      "executor": "nx:noop",
      "dependsOn": ["test"]
    },
    "runtime-type-tests": {
      "executor": "nx:noop",
      "dependsOn": ["type-tests"]
    },
    "runtime-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node fixtures/react-parity/native-ag-ui-live/prepare.mjs && node --test --test-concurrency=1 fixtures/react-parity/native-ag-ui-live/python.live.spec.mjs fixtures/react-parity/native-ag-ui-live/mastra.live.spec.mjs"
      }
    },
    "prepare-install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/libs/telemetry/install/*.cjs",
        "{workspaceRoot}/libs/telemetry/install/assemble-package.mjs",
        "{projectRoot}/package.json"
      ],
      "outputs": ["{projectRoot}/.install-collector"],
      "options": {
        "command": "node libs/telemetry/install/assemble-package.mjs ag-ui",
        "forwardAllArgs": false
      }
    }
  },
  "implicitDependencies": ["telemetry"]
}
