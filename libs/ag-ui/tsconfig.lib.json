{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../dist/libs/ag-ui",
    "declaration": true,
    "emitDeclarationOnly": false,
    "importHelpers": false,
    "module": "ES2022",
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.type-test.ts",
    "src/runtime/testing/**"
  ]
}
