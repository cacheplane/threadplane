    "@langchain/langgraph": "^1.4.2",
    "@nx/angular": "^22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "22.6.0",
    "@nx/next": "^22.6.0",
    "@nx/playwright": "^22.6.0",
    "@nx/vite": "^22.5.4",
    "@playwright/test": "^1.58.2",
    "@schematics/angular": "~21.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
