    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.0.5",
    "vitest": "^4.1.0",
    "zod": "^3.25.76"
