    "@vitest/coverage-v8": "^4.1.0",
    "aimock": "npm:@copilotkit/aimock@^1.39.0",
    "angular-eslint": "^21.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^29.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "katex": "^0.17.0",
    "marked": "^15.0.0",
    "msw": "^2.4.9",
