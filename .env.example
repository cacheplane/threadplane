# Threadplane local environment template
# Values are intentionally blank. Fill only the services needed for your work.
# Keep this grouping aligned with .env.

# Hosting and deployment
# Railway entries are project/environment deployment credentials.
# AG_UI_DEMO_RAILWAY_TOKEN also belongs in the matching GitHub Actions secret.
VERCEL_API_TOKEN=
RAILWAY_TOKEN=
AG_UI_DEMO_RAILWAY_TOKEN=

# Package publishing
NPM_TOKEN=
PYPI_API_TOKEN=

# AI providers and LangSmith
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=

# Cockpit and website configuration
# NEXT_PUBLIC_ values are exposed to browser code; never put secrets in them.
NEXT_PUBLIC_COCKPIT_RUNTIME_BASE_URL=
COCKPIT_WEBSITE_ORIGIN=

# AG-UI runtime authentication
# Shared by the Vercel proxy and Railway backend; not a Railway deployment token.
AG_UI_INTERNAL_TOKEN=

# Analytics
# PostHog dashboards-as-code (tools/posthog/).
# Generate a Personal API Key at https://us.posthog.com/me/settings#personal-api-keys
# Required scopes: dashboard:write, insight:write, cohort:write, project:read
# Typical PostHog host: https://us.i.posthog.com
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PERSONAL_API_KEY_READONLY=

# Redis and Upstash
UPSTASH_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Growth database
GROWTH_PRODUCTION_DATABASE_URL=
GROWTH_PRODUCTION_DATABASE_URL_UNPOOLED=

# Payments
STRIPE_SECRET_KEY=

# Email and lifecycle
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=
RESEND_RECEIVING_ENABLED=false
RESEND_RECEIVING_STARTED_AT=
LIFECYCLE_SERVICE_SECRET=
GROWTH_EMAIL_HMAC_ACTIVE_SECRET=
GROWTH_EMAIL_HMAC_ACTIVE_VERSION=

# Social publishing — X
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_USER_HANDLE=

# Social publishing — LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_EXPIRES_AT=
# Set to 1 only if the LinkedIn app has partner access to the comments API (firstComment).
LINKEDIN_PARTNER_COMMENTS=

# Weekly content automation (Neon holds the channel tokens, sealed; see docs/growth/marketing-queue-rollout.md)
# Base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MARKETING_CREDENTIALS_KEY=
# Preview lifecycle Growth DATABASE_URL (same value; marketing tables live there). Queue and auth CLIs --target=preview
MARKETING_DATABASE_URL_PREVIEW=
# Production lifecycle Growth DATABASE_URL (same value; marketing tables live there). Queue and auth CLIs --target=production
MARKETING_DATABASE_URL_PRODUCTION=
# Vercel Blob read-write token (queue CLI media upload)
BLOB_READ_WRITE_TOKEN=
# Lifecycle (Vercel) only: dispatcher switch, exact string true enables posting
MARKETING_POSTING_ENABLED=
# Lifecycle (Vercel) only: website deploy hook that publishes a due blog post
MARKETING_WEBSITE_DEPLOY_HOOK_URL=
# Lifecycle (Vercel) only: From address for marketing failure alerts
MARKETING_ALERT_FROM=
# Lifecycle (Vercel) only: where marketing failure alerts are sent (also needs RESEND_API_KEY)
FOUNDER_NOTIFICATION_EMAIL=

# Maps
GOOGLE_MAPS_API_KEY=

# Optional telemetry configuration (libs/telemetry/README.md)
# NGAF_TELEMETRY_INGEST_URL=https://threadplane.ai/api/ingest
# NGAF_TELEMETRY_SAMPLE_RATE=1.0
# DO_NOT_TRACK=1
# NGAF_TELEMETRY_DISABLED=1
