{
  "name": "cockpit-chat-debug-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/chat/debug/react/src",
  "projectType": "application",
  "implicitDependencies": [
    "cockpit-chat-debug-angular",
    "cockpit-chat-debug-python"
  ],
  "tags": [
    "scope:cockpit-examples",
    "scope:cockpit-e2e",
    "framework:react"
  ],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/chat/debug/react/vite.config.mts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "core",
            "content",
            "react"
          ]
        },
        {
          "target": "react-langgraph",
          "projects": [
            "website-runtime-preparation"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/cockpit/chat/debug/react"
      ],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs chat-debug"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "inputs": [
        "default",
        "reactAimockBackend",
        "debugProbe"
      ],
      "dependsOn": [
        "build",
        {
          "target": "test",
          "projects": [
            "cockpit-chat-debug-python"
          ]
        }
      ],
      "options": {
        "config": "cockpit/chat/debug/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    }
  },
  "namedInputs": {
    "debugProbe": [
      "{workspaceRoot}/scripts/react-cockpit/chat-debug-configuration.spec.mjs",
      "{workspaceRoot}/scripts/react-cockpit/chat-debug-native-session-probe.mjs",
      "{workspaceRoot}/fixtures/react-parity/langgraph-package/chat-debug-native-session.mjs",
      "{workspaceRoot}/cockpit/chat/debug/angular/e2e/fixtures/c-debug.json"
    ]
  }
}
