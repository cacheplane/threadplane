{
  "name": "cockpit-chat-debug-python",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/chat/debug/python/src",
  "projectType": "library",
  "targets": {
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["test"],
      "options": {
        "cwd": "cockpit/chat/debug/python",
        "command": "npx tsx -e \"import { chatDebugPythonModule } from './src/index.ts'; const module = chatDebugPythonModule; if (module.id !== 'chat-debug-python' || module.title !== 'Chat Debug (Python)') { throw new Error('Unexpected module shape for ' + module.id); }\""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "cockpit/chat/debug/python",
        "command": "uv run --frozen --python 3.12 python -E -B -m unittest discover -s tests"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/dist/cockpit/chat/debug/python"
      ],
      "options": {
        "outputPath": "dist/cockpit/chat/debug/python",
        "main": "cockpit/chat/debug/python/src/index.ts",
        "tsConfig": "cockpit/chat/debug/python/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "cockpit/chat/debug/python",
        "command": "uv run langgraph dev --port 5509 --no-browser"
      }
    }
  },
  "tags": [
    "scope:cockpit-e2e",
    "scope:cockpit-examples",
    "scope:cockpit-smoke"
  ]
}
