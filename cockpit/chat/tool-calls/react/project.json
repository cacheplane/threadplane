{
  "name": "cockpit-chat-tool-calls-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/chat/tool-calls/react/src",
  "projectType": "application",
  "implicitDependencies": ["cockpit-chat-tool-calls-angular", "cockpit-chat-tool-calls-python"],
  "tags": ["scope:cockpit-examples", "scope:cockpit-e2e", "framework:react"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": ["core", "content", "react"]
        },
        { "target": "react-langgraph", "projects": ["website-runtime-preparation"] }
      ],
      "outputs": ["{workspaceRoot}/dist/cockpit/chat/tool-calls/react"],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs chat-tool-calls"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/chat/tool-calls/react/vite.config.mts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "inputs": ["default", "reactAimockBackend"],
      "dependsOn": ["build", { "target": "test", "projects": ["cockpit-chat-tool-calls-python"] }],
      "options": {
        "config": "cockpit/chat/tool-calls/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    }
  }
}
