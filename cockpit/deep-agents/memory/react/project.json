{
  "name": "cockpit-deep-agents-memory-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/deep-agents/memory/react/src",
  "projectType": "application",
  "tags": ["scope:cockpit-examples", "scope:cockpit-e2e", "framework:react"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [ { "target": "build", "projects": ["cockpit-deep-agents-memory-react"] }, { "target": "fixture-test", "projects": ["cockpit-deep-agents-memory-react"] } ],
      "options": { "config": "cockpit/deep-agents/memory/react/e2e/playwright.config.ts" }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "cache": false,
      "options": {
        "configFile": "cockpit/deep-agents/memory/react/vite.config.mts",
        "reporters": ["default"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": ["core", "content", "react"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/cockpit/deep-agents/memory/react"],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs deep-agents-memory"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "cockpit/deep-agents/memory/react/eslint.config.mjs"
      }
    },
    "configuration-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/react-cockpit/deep-agents-memory-configuration.spec.mjs"
      }
    },
    "fixture-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "test",
          "projects": ["cockpit-deep-agents-memory-python"]
        }
      ],
      "options": {
        "command": "node --test scripts/react-cockpit/deep-agents-memory-fixture.spec.mjs scripts/react-cockpit/deep-agents-memory-configuration.spec.mjs"
      }
    }
  }
}
