{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "paths": {
      "@threadplane/core": [
        "libs/core/src/index.ts"
      ],
      "@threadplane/core/tools": [
        "libs/core/src/tools/index.ts"
      ],
      "@threadplane/content": [
        "libs/content/src/index.ts"
      ],
      "@threadplane/content/messages": [
        "libs/content/src/messages/index.ts"
      ],
      "@threadplane/content/markdown": [
        "libs/content/src/markdown/index.ts"
      ],
      "@threadplane/react": [
        "libs/react/src/index.ts"
      ],
      "@threadplane/react/chat": [
        "libs/react/src/chat/index.ts"
      ],
      "@threadplane/react/markdown": [
        "libs/react/src/markdown/index.ts"
      ],
      "@threadplane/langgraph": [
        "libs/langgraph/src/runtime/create-session.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts"
  ]
}
