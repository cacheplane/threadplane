{
  "name": "cockpit-deep-agents-subagents-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/deep-agents/subagents/react/src",
  "projectType": "application",
  "tags": [
    "scope:cockpit-examples",
    "scope:cockpit-e2e",
    "framework:react"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "core",
            "content",
            "react"
          ]
        },
        { "target": "react-langgraph", "projects": ["website-runtime-preparation"] }
      ],
      "outputs": [
        "{workspaceRoot}/dist/cockpit/deep-agents/subagents/react"
      ],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs deep-agents-subagents"
      }
    },
    "fixture-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "test",
          "projects": [
            "cockpit-deep-agents-subagents-python"
          ]
        }
      ],
      "options": {
        "command": "node --test scripts/react-cockpit/deep-agents-subagents-fixture.spec.mjs scripts/react-cockpit/deep-agents-subagents-configuration.spec.mjs"
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        "build",
        "fixture-test"
      ],
      "options": {
        "config": "cockpit/deep-agents/subagents/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/deep-agents/subagents/react/vite.config.mts",
        "reporters": [
          "default"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "cockpit/deep-agents/subagents/react/eslint.config.mjs"
      }
    }
  }
}
