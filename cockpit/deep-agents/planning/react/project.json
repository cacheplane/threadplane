{
  "name": "cockpit-deep-agents-planning-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/deep-agents/planning/react/src",
  "projectType": "application",
  "tags": ["scope:cockpit-examples", "scope:cockpit-e2e", "framework:react"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        { "target": "build", "projects": ["core", "content", "react"] }
      ],
      "outputs": ["{workspaceRoot}/dist/cockpit/deep-agents/planning/react"],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs deep-agents-planning"
      }
    },
    "fixture-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "test",
          "projects": ["cockpit-deep-agents-planning-python"]
        }
      ],
      "options": {
        "command": "node --test scripts/react-cockpit/deep-agents-planning-fixture.spec.mjs scripts/react-cockpit/deep-agents-planning-configuration.spec.mjs"
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": ["build", "fixture-test"],
      "options": {
        "config": "cockpit/deep-agents/planning/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/deep-agents/planning/react/vite.config.mts",
        "reporters": ["default"]
      }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
