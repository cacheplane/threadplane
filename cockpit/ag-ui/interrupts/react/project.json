{
  "name": "cockpit-ag-ui-interrupts-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/ag-ui/interrupts/react/src",
  "projectType": "application",
  "tags": ["scope:cockpit-examples", "scope:cockpit-e2e", "framework:react"],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/ag-ui/interrupts/react/vite.config.mts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": ["core", "content", "react"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/cockpit/ag-ui/interrupts/react"],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs ag-ui-interrupts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "config": "cockpit/ag-ui/interrupts/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    }
  }
}
