{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "paths": {
      "@threadplane/core": ["libs/core/src/index.ts"],
      "@threadplane/core/tools": ["libs/core/src/tools/index.ts"],
      "@threadplane/ag-ui": ["fixtures/react-parity/ag-ui-candidate/entry.ts"],
      "@threadplane/a2ui": ["libs/a2ui/src/index.ts"],
      "@threadplane/content/markdown": ["libs/content/src/markdown/index.ts"],
      "@threadplane/content/messages": ["libs/content/src/messages/index.ts"],
      "@threadplane/content/json": ["libs/content/src/json/index.ts"],
      "@threadplane/content/a2ui": ["libs/content/src/a2ui/index.ts"],
      "@threadplane/content/render-state": [
        "libs/content/src/render-state/index.ts"
      ],
      "@threadplane/react": ["libs/react/src/index.ts"],
      "@threadplane/react/chat": ["libs/react/src/chat/index.ts"],
      "@threadplane/react/markdown": ["libs/react/src/markdown/index.ts"],
      "@threadplane/react/render": ["libs/react/src/render/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
