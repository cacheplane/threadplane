{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "composite": false,
    "emitDeclarationOnly": false,
    "paths": {
      "@threadplane/core": ["libs/core/src/index.ts"],
      "@threadplane/core/tools": ["libs/core/src/tools/index.ts"],
