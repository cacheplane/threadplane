{
  "name": "cockpit-ag-ui-client-tools-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/ag-ui/client-tools/react/src",
  "projectType": "application",
  "implicitDependencies": [
    "cockpit-ag-ui-client-tools-angular",
    "cockpit-ag-ui-client-tools-python"
  ],
  "tags": [
    "scope:cockpit-examples",
    "scope:cockpit-e2e",
    "framework:react"
  ],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/ag-ui/client-tools/react/vite.config.mts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "core",
            "content",
            "react"
          ]
        },
        {
          "target": "react-ag-ui",
          "projects": [
            "website-runtime-preparation"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/cockpit/ag-ui/client-tools/react"
      ],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs ag-ui-client-tools"
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        "build",
        {
          "target": "test",
          "projects": [
            "cockpit-ag-ui-client-tools-python"
          ]
        }
      ],
      "options": {
        "config": "cockpit/ag-ui/client-tools/react/e2e/playwright.config.ts",
        "skipInstall": true
      },
      "inputs": [
        "default",
        "reactAimockBackend"
      ]
    }
  }
}
