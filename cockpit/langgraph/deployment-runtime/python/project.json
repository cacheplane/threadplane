{
  "name": "cockpit-langgraph-deployment-runtime-python",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/langgraph/deployment-runtime/python/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/dist/cockpit/langgraph/deployment-runtime/python"
      ],
      "options": {
        "outputPath": "dist/cockpit/langgraph/deployment-runtime/python",
        "main": "cockpit/langgraph/deployment-runtime/python/src/index.ts",
        "tsConfig": "cockpit/langgraph/deployment-runtime/python/tsconfig.json"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "cockpit/langgraph/deployment-runtime/python",
        "parallel": false,
        "commands": [
          "npx tsx -e \"import { langgraphDeploymentRuntimePythonModule } from './src/index.ts'; const module = langgraphDeploymentRuntimePythonModule; if (module.id !== 'langgraph-deployment-runtime-python' || module.title !== 'LangGraph Deployment Runtime (Python)') { throw new Error('Unexpected module shape for ' + module.id); }\"",
          "uv run --frozen --python 3.12 python -m unittest discover -s tests"
        ]
      }
    }
  },
  "tags": [
    "scope:cockpit-e2e",
    "scope:cockpit-examples",
    "scope:cockpit-smoke"
  ]
}
