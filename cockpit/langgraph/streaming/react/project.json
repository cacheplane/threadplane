{
  "name": "cockpit-langgraph-streaming-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/langgraph/streaming/react/src",
  "projectType": "application",
  "tags": ["scope:cockpit-examples", "scope:cockpit-e2e", "framework:react"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "outputs": ["{workspaceRoot}/dist/cockpit/langgraph/streaming/react"],
      "options": { "command": "node scripts/react-cockpit/build.mjs" }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/langgraph/streaming/react/vite.config.mts"
      }
    },
    "lint": { "executor": "@nx/eslint:lint" },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "config": "cockpit/langgraph/streaming/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    }
  }
}
