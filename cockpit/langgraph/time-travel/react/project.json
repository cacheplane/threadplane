{
  "name": "cockpit-langgraph-time-travel-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/langgraph/time-travel/react/src",
  "projectType": "application",
  "tags": [
    "scope:cockpit-examples",
    "scope:cockpit-e2e",
    "framework:react"
  ],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/langgraph/time-travel/react/vite.config.mts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "core",
            "content",
            "react"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/cockpit/langgraph/time-travel/react"
      ],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs time-travel"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "config": "cockpit/langgraph/time-travel/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    }
  }
}
