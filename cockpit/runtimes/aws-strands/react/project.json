{
  "name": "cockpit-runtimes-aws-strands-react",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "cockpit/runtimes/aws-strands/react/src",
  "projectType": "application",
  "implicitDependencies": [
    "cockpit-runtimes-aws-strands-angular",
    "cockpit-runtimes-aws-strands-python"
  ],
  "tags": [
    "scope:cockpit-examples",
    "scope:cockpit-e2e",
    "framework:react"
  ],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "cache": false,
      "inputs": [
        "default",
        "reactAimockBackend"
      ],
      "dependsOn": [
        "build"
      ],
      "options": {
        "config": "cockpit/runtimes/aws-strands/react/e2e/playwright.config.ts",
        "skipInstall": true
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "cockpit/runtimes/aws-strands/react/vite.config.mts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "core",
            "content",
            "react"
          ]
        },
        {
          "target": "react-ag-ui",
          "projects": [
            "website-runtime-preparation"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/cockpit/runtimes/aws-strands/react"
      ],
      "options": {
        "command": "node scripts/react-cockpit/build.mjs runtimes-aws-strands"
      }
    }
  }
}
